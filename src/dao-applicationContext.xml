   <bean id="promisDS" class="org.springframework.jndi.JndiObjectFactoryBean">
        <property name="jndiName" value="jdbc/promisDS"/>
    </bean>
    <bean id="goldDS" class="org.springframework.jndi.JndiObjectFactoryBean">
        <property name="jndiName" value="jdbc/goldDS"/>
    </bean>
    <bean id="sqlMapClient"
          class="org.springframework.orm.ibatis.SqlMapClientFactoryBean">
        <property name="configLocation">
            <value>classpath:gaswsSqlMapConfig.xml</value>
        </property>
    </bean>      
    
     <bean id="integrationDAO" class="com.dpw.gasws.dao.IntegrationDAOImpl">  
            <property name="dataSource">
		<ref local="promisDS"/>
	   </property>
            <property name="goldDS">
                    <ref bean="goldDS" />
            </property>
            <property name="promisDS">
                    <ref bean="promisDS" />
            </property>
            <property name="sqlMapClient">
                    <ref bean="sqlMapClient" />
            </property>   
            <property name="getEirLocationDetailsProc">
               <ref local="getEirLocationDetailsProc"/>
	    </property>
            <property name="getEirLocationDetailsProcGold">
               <ref local="getEirLocationDetailsProcGold"/>
	    </property>
    </bean>    
    
    <bean id="getEirLocationDetailsProc" class="com.dpw.gasws.dao.GetEirLocationDetailsProc">
        <constructor-arg index="0" ref="promisDS"/>        
    </bean>
    <bean id="getEirLocationDetailsProcGold" class="com.dpw.gasws.dao.GetEirLocationDetailsProc">
        <constructor-arg index="0" ref="goldDS"/>        
    </bean>  
  
</beans>
